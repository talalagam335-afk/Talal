# NextMove environment configuration
#
# Copy this file to `.env.local` and fill in a real key to use the live Claude
# provider. If no key is set, the app automatically falls back to the built-in
# MOCK provider so the vertical slice still runs end-to-end without any secret.
#
# The key is read ONLY on the server (inside the /api/generate route). It is
# never exposed to the browser.

# Anthropic Claude API key (leave empty to use the mock provider)
ANTHROPIC_API_KEY=

# Optional: override the Claude model id used by the live provider
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: force a provider regardless of key presence ("mock" | "claude")
# AI_PROVIDER=mock
